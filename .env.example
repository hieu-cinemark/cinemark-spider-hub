# Kafka - only needed to run crawl_request_consumer.py (the production
# entry point). Not needed for ad-hoc `scrapy crawl ...` runs.
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# Redis - session cache, token cache, account rotation, dedupe sets
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# Which database social_crawler/services/db.py connects to - "production"
# (the default if unset, so an existing deployed .env with no APP_ENV set
# keeps hitting Supabase exactly as before) or "development", which reads
# LOCAL_DATABASE_URL instead of DATABASE_URL below. Local dev/testing
# (account/proxy pool changes especially - see services/pool.py) should
# always run against the local DB, never prod - set this to "development".
APP_ENV=production

# Postgres - account credentials and proxy config live here now
# (platform_accounts / platform_proxies tables, see social_crawler/services/db.py),
# not as env vars - they change too often for editing this file + restarting
# every process to be worth it. Required: bootstrap.py and every
# `scrapy crawl ...` will fail to find an account/proxy without it.
#
#   platform_accounts: platform ('facebook'|'threads'), account_id, password,
#     totp_secret, cookie, token, email, enabled, status, cooldown_until,
#     consecutive_failures, last_used_at (last 4: see services/pool.py)
#   platform_proxies: platform ('facebook'|'threads'|'all' for shared),
#     proxy_url, username, password, login_use_proxy, enabled, status,
#     cooldown_until, consecutive_failures, last_used_at
#
# DATABASE_URL is prod (Supabase) - used whenever APP_ENV=production.
DATABASE_URL=postgresql://user:password@host:6543/postgres
# LOCAL_DATABASE_URL is dev - used whenever APP_ENV=development. Points at
# the "postgres" service in the workspace root docker-compose.yml by
# default; run scripts/dev_db_schema.sql against it once to create the
# tables (see that file for the exact command and how to seed a test
# account/proxy - don't put real credentials in this example file).
LOCAL_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/spider_hub_dev

# TELEGRAM
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Kira (LLM) credentials + model are not env vars - they live in the Supabase
# ai_providers table (key=kira), edited from the dashboard Settings AI tab.

# Rotating-proxy vendor tokens (proxiestrust) are not env vars - they live in
# the Supabase proxy_providers table, edited from the dashboard Settings page
# (see social_crawler/services/proxy_settings.py).

# Logging (shared contract with cinemark-api - see social_crawler/logger.py)
# LOG_FORMAT: console (default, human-readable) | json (one JSON object per line)
LOG_FORMAT=console
# LOG_LEVEL: debug | info (default) | warning | error
LOG_LEVEL=info

# Public Facebook comments (anonymous; this proxy must not be assigned to any account).
FACEBOOK_PUBLIC_COMMENTS_PROXY_ID=10
FACEBOOK_PUBLIC_COMMENTS_INTERVAL=5
FACEBOOK_PUBLIC_COMMENTS_DAILY_CAP=400
FACEBOOK_PUBLIC_COMMENTS_MAX_REQUESTS=400
# Logged-out page reads: listed proxies must have platform='public' and no assigned accounts (even disabled).
FB_PUBLIC_PAGES_PROXY_IDS=15,10
# Parallel jobs per proxy; workers = proxies x this. Above 1 multiplies the request rate on that IP.
FB_PUBLIC_PAGES_PER_PROXY=1
# How often a proxy in cooldown re-checks its exit IP; a new unblocked IP ends the cooldown early.
FB_PUBLIC_PAGES_IP_CHECK_SECONDS=60
# 1: anonymous comments and page reads wait while Facebook keyword searches are queued.
FB_PUBLIC_YIELD_TO_SEARCH=1
# Minimum gap x pace between two page opens on one proxy.
FB_PUBLIC_PAGES_HTML_GAP_SECONDS=120
# Date window size with saved progress (0 = read the whole range as one window).
FB_PUBLIC_PAGES_WINDOW_DAYS=7
# Pace: blocked signals double the request interval up to this factor; a clean job halves it.
FB_PUBLIC_PAGES_MAX_PACE=8
# Minimum rest x pace before a blocked proxy may be released by a new IP.
FB_PUBLIC_PAGES_MIN_REST_SECONDS=300
FB_PUBLIC_PAGES_BLOCK_STRIKES=3
FB_PUBLIC_PAGES_COOLDOWN_MINUTES=120
# Includes the initial HTML page; 0 scans the date window without a page limit.
FB_PUBLIC_PAGES_MAX_PAGES=0
FB_PUBLIC_PAGES_SINCE_DAYS=60
FB_PUBLIC_PAGES_REQUEST_INTERVAL=5
# Optional override; blank discovers the feed operation from public bundles and caches by server revision.
FB_PUBLIC_PAGES_DOC_ID=
# Optional current GraphQL IDs; blank uses the pinned upstream defaults/public registry.
FBGQL_DOC_ID_COMMENTS=
FBGQL_DOC_ID_REPLIES=

# Facebook account budget per account. Hourly cap is off by default: delete any FACEBOOK_HOURLY_REQUEST_CAP left in .env.
FACEBOOK_DAILY_REQUEST_CAP=400
# Build missing query recipes over HTTP from an existing cookie + recorded origin User-Agent.
# Uses pinned facebook-gql-scraper templates/V8; never logs in or retries blocked accounts.
FACEBOOK_GQL_FALLBACK_ENABLED=1
# Facebook rests after the previous response; each UID gets a stable, slightly slower range.
# FACEBOOK_MIN_REQUEST_INTERVAL=5
# FACEBOOK_REQUEST_JITTER=5
# Newest allowed session age when importing a Facebook cookie. A starting point, not proven. Keep equal in cinemark-api.
# FACEBOOK_COOKIE_MAX_AGE_DAYS=180
# Distinct exit IPs in one hour that mark a proxy labelled static as rotating.
# META_ROTATION_DISTINCT_IPS=3
# Daily caps used after an account has been idle, one per day, before the full daily cap.
FACEBOOK_RESTART_DAILY_CAPS=100,150,200,300
FACEBOOK_RESTART_IDLE_DAYS=3

# Consumer loops on this machine; empty = all. See docs/facebook-local.md.
# VPS when Facebook accounts run on a Mac: facebook_public,threads,tiktok
CRAWLER_PLATFORMS=

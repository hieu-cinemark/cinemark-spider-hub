# Kafka - only needed to run crawl_request_consumer.py (the production
# entry point). Not needed for ad-hoc `scrapy crawl ...` runs.
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# Redis - session cache, token cache, account rotation, dedupe sets
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# Supabase Postgres - account credentials and proxy config live here now
# (platform_accounts / platform_proxies tables, see social_crawler/services/db.py),
# not as env vars - they change too often for editing this file + restarting
# every process to be worth it. Required: bootstrap.py and every
# `scrapy crawl ...` will fail to find an account/proxy without it.
#
#   platform_accounts: platform ('facebook'|'threads'), account_id, password,
#     totp_secret, cookie, token, email, enabled
#   platform_proxies: platform ('facebook'|'threads'|'all' for shared),
#     proxy_url, username, password, login_use_proxy, enabled
DATABASE_URL=postgresql://user:password@host:6543/postgres

# TELEGRAM
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

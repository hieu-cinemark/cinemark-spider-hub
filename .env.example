# Kafka - only needed to run crawl_request_consumer.py (the production
# entry point). Not needed for ad-hoc `scrapy crawl ...` runs.
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# Redis - session cache, token cache, account rotation, dedupe sets
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# PROXY
LOGIN_USE_PROXY=True
PROXY_URL=
PROXY_USERNAME=
PROXY_PASSWORD=

# FACEBOOK
# JSON array, every key required (use "" for anything an account doesn't
# have) - see social_crawler/spiders/facebook/auth/accounts.py. Wrap in
# single quotes so python-dotenv parses the multi-line/embedded-double-quote
# value correctly.
FACEBOOK_ACCOUNTS='[{"id":"you@example.com","password":"...","2fa":"","cookie":"","token":"","email":""}]'

# TELEGRAM
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Kafka - only needed to run crawl_request_consumer.py (the production
# entry point). Not needed for ad-hoc `scrapy crawl ...` runs.
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# Redis - session cache, token cache, account rotation, dedupe sets
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# D1 cinemark-config-db: tài khoản (platform_accounts), proxy (platform_proxies), cấu hình AI/cào. Truy cập qua HTTP API của Cloudflare
# (xem cinemark-api/docs/config-db-d1.md). Tài khoản/proxy không nằm trong env vì đổi quá thường xuyên. Bắt buộc: thiếu thì
# bootstrap.py và mọi `scrapy crawl ...` không tìm thấy tài khoản/proxy.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_D1_CONFIG_DATABASE_ID=

# TELEGRAM
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# LLM credentials + model are not env vars - they live in the D1
# ai_providers table, edited from the dashboard Settings AI tab.

# Rotating-proxy vendor tokens are not env vars - they live in the D1
# proxy_providers table (with a `kind` column telling which vendor API applies),
# edited from the dashboard Settings page (see social_crawler/db/proxy_settings.py).

# Logging (shared contract with cinemark-api - see social_crawler/logger.py)
# LOG_FORMAT: console (default, human-readable) | json (one JSON object per line)
LOG_FORMAT=console
# LOG_LEVEL: debug | info (default) | warning | error
LOG_LEVEL=info

# Public Facebook comments: proxy id, interval and caps live in D1 proxy_settings (dashboard Settings > Proxy:
# public_comments_*), not here.
# Logged-out Threads channel reads (job threads_channel, queue crawl_public_pages:threads; uses the 'public' proxies).
THREADS_CHANNEL_SINCE_DAYS=30
THREADS_CHANNEL_MAX_PAGES=20
THREADS_CHANNEL_REQUEST_INTERVAL=3
THREADS_CHANNEL_COOLDOWN_MINUTES=30
# TikTok consumers running side by side (crawl_requests needs at least this many partitions). Each lane keeps its own
# port of the tiktok_synthetic_provider source, so use no more lanes than that source has unpinned ports.
TIKTOK_LANES=1
TIKTOK_LANE_PORT_TTL_SECONDS=1800
# How often a proxy in cooldown re-checks its exit IP; a new unblocked IP ends the cooldown early.
FB_PUBLIC_PAGES_IP_CHECK_SECONDS=60
# 1: anonymous comments and page reads wait while Facebook keyword searches are queued.
FB_PUBLIC_YIELD_TO_SEARCH=0
# Minimum gap x pace between two page opens on one proxy.
# Date window size with saved progress (0 = read the whole range as one window).
FB_PUBLIC_PAGES_WINDOW_DAYS=7
# Pace: blocked signals double the request interval up to this factor; a clean job halves it.
FB_PUBLIC_PAGES_MAX_PACE=8
# Minimum rest x pace before a blocked proxy may be released by a new IP.
FB_PUBLIC_PAGES_MIN_REST_SECONDS=300
FB_PUBLIC_PAGES_BLOCK_STRIKES=3
FB_PUBLIC_PAGES_COOLDOWN_MINUTES=120
# Includes the initial HTML page; 0 scans the date window without a page limit.
FB_PUBLIC_PAGES_MAX_PAGES=0
FB_PUBLIC_PAGES_SINCE_DAYS=60
FB_PUBLIC_PAGES_REQUEST_INTERVAL=3
# Optional override; blank discovers the feed operation from public bundles and caches by server revision.
FB_PUBLIC_PAGES_DOC_ID=
# Optional current GraphQL IDs; blank uses the pinned upstream defaults/public registry.
FBGQL_DOC_ID_COMMENTS=
FBGQL_DOC_ID_REPLIES=

# Facebook/Threads request budgets (daily/hourly caps, fresh/deep split, new-account ramp, restart ramp, continuous-run limits)
# live in D1 proxy_settings (dashboard Settings > Proxy, keys fb_* / threads_hourly_request_cap), NOT here. The old
# FACEBOOK_DAILY_REQUEST_CAP / FACEBOOK_RUN_* / FACEBOOK_*_PERIODS / FACEBOOK_NEW_ACCOUNT_* / FACEBOOK_RESTART_* variables are no longer read.
# Build missing query recipes over HTTP from an existing cookie + recorded origin User-Agent.
# Uses pinned facebook-gql-scraper templates/V8; never logs in or retries blocked accounts.
FACEBOOK_GQL_FALLBACK_ENABLED=1
# Facebook rests after the previous response; each UID gets a stable, slightly slower range.
# FACEBOOK_MIN_REQUEST_INTERVAL=5
# FACEBOOK_REQUEST_JITTER=5
# Newest allowed session age when importing a Facebook cookie. A starting point, not proven. Keep equal in cinemark-api.
# FACEBOOK_COOKIE_MAX_AGE_DAYS=180

# Quiet hours and pauses between Facebook/Threads jobs live in proxy_settings (dashboard Settings > Proxy > "Facebook/Threads
# job pacing": meta_quiet_hours, *_job_pause_*, facebook_*stale_job_hours), not here - META_QUIET_HOURS and FACEBOOK_PAUSE_* are no
# longer read.

# Consumer loops on this machine; empty = all. See docs/facebook-local.md.
# VPS when Facebook accounts run on a Mac: facebook_public,threads,tiktok
CRAWLER_PLATFORMS=

# YouTube (no account, InnerTube; logic from data-miner). Runs when "youtube" is in CRAWLER_PLATFORMS (or the list is empty).
# Each keyword goes through every search filter below, up to YOUTUBE_SEARCH_PAGES pages each, stopping a filter after
# YOUTUBE_SEEN_ONLY_PAGES pages with no new video. Empty proxy = machine IP.
YOUTUBE_SEARCH_MODES=relevance,today,week,month,year,shorts,videos,under4,4to20,over20,view_count,newest
YOUTUBE_SEEN_ONLY_PAGES=5
YOUTUBE_META_CONCURRENCY=6
YOUTUBE_COMMENTS_MAX=1000
YOUTUBE_SEEN_POSTS_TTL_SECONDS=86400
# YouTube lanes: parallel in-process workers on the Redis queues crawl_youtube:search / crawl_youtube:comments (the Kafka
# loop only forwards). Proxies: rows with platform='youtube' in platform_proxies, one per lane round-robin; a failing proxy
# rests YOUTUBE_PROXY_REST_SECONDS and the lane uses another exit or the machine IP.

# Proxies (13/11/2026): every proxy is a rotating proxy with a platform (facebook, threads, tiktok, youtube, public, all).
# Jobs rotate through their platform's list, one account per proxy while a job runs, and borrow an idle proxy of another
# platform when their own list is busy. Lanes, workers, page gaps and queue targets are edited in the dashboard
# (Settings > Proxy > "Crawl performance", table proxy_settings), not here.

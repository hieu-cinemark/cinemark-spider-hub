[Unit]
Description=spider-hub manual login - virtual display :99 (Xvfb) for the headed Chromium of scripts/manual_login.py
After=network.target

[Service]
User=app
Group=app
# 1920x1200: fits the largest viewport new_context() gives an account (1920x1080) plus the browser toolbar.
# -nolisten tcp: only local X clients (the Chromium started by manual_login.py, x11vnc). -ac: no xauth cookie needed
# between them (same machine, TCP off).
ExecStart=/usr/bin/Xvfb :99 -screen 0 1920x1200x24 -nolisten tcp -ac
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
